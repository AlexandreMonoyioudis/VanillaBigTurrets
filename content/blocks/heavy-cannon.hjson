{
  type: "ItemTurret"
  name: "Heavy-Cannon"
  localizedName: "Heavy Cannon"
  description: "The heavy cannon is fires heavy metals. The cannon requires a massive amount of coolant to shoot continuously."
  health: 600
  size: 2
  inaccuracy: 1
  ammoUseEffect: casing1
  reload: 500
  range: 220
  recoil: 2
  shootSound: "shootSpectre"
  researchCostMultiplier: 0.35
  buildCostMultiplier: 0.75
  coolantMultiplier: 50
  maxAmmo: 3
  ammoPerShot: 1

  consumes: {
  coolant: {
    amount: 0.2
  }
}

  requirements: [
    copper/150
    lead/150
    metaglass/10
  ]

  ammoTypes: {
    copper: {
      speed: 20
      damage: 25
      bulletWidth: 20
      bulletHeight: 22
      lifetime: 40
	    reloadMultiplier: 2
      shootEffect: "shootBig"
    }

    metaglass:	{
		type: ArtilleryBulletType
		speed: 10
		splashDamage: 40
		splashDamageRadius: 20
		knockback: 0
		lifetime: 20
		width: 20
		height: 20
		collidesTiles: true
		fragBullet: {
			type: BasicBulletType
			speed: 5
			damage: 10
			width: 10
			height: 12
			shrinkY: 1
			lifetime: 15
			despawnEffect: none
			collidesAir: true
		}
		fragBullets: 10
	  reloadMultiplier: 0.5
	}

    lead: {
      speed: 10
      damage: 100
      bulletWidth: 120
      bulletHeight: 120
      lifetime: 40
		  pierce: true
      shootEffect: "shootBig2"
	    reloadMultiplier: 0.5
    }

    graphite: {
      speed: 20
      damage: 125
      bulletWidth: 120
      bulletHeight: 120
      lifetime: 40
		  pierce: true
      shootEffect: "shootBig2"
	    reloadMultiplier: 0.5
    }

    silicon: {
      speed: 20
      damage: 125
      bulletWidth: 120
      bulletHeight: 120
      lifetime: 40
		  pierce: true
      shootEffect: "shootBig2"
	    reloadMultiplier: 0.5
      homingPower: 0.5
      homingRange: 1
    }

    titanium: {
      speed: 20
      damage: 80
      bulletWidth: 80
      bulletHeight: 80
      lifetime: 40
		  pierce: true
      shootEffect: "shootBig2"
    }

    pyratite: {
	  frontColor: FC9D5DFF
	  backColor: FFAD7DFF
	  status: burning
      speed: 20
      damage: 125
      bulletWidth: 80
      bulletHeight: 80
      lifetime: 40
      shootEffect: "shootBig2"
    }
  }

  category: "turret"
  research: "wave"
}