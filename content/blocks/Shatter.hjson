{
  type: "ItemTurret"
  name: "Shatter"
  localizedName: "Shattern"
  description: "Fires clumps of metaglass, plastanium or silicon missiles."
  health: 600
  size: 3
  inaccuracy: 10
  ammoUseEffect: casing1
  reload: 100
  range: 400
  recoil: 0.05
  ammoEjectBack: 2
  researchCostMultiplier: 0.35
  buildCostMultiplier: 0.75
  coolantMultiplier: 20
  maxAmmo: 60
  ammoPerShot: 5
  rotateSpeed: 50
  targetGround: false
  targetAir: true


  consumes: {
  coolant: {
    amount: 0.05
  }
}

  requirements: [
    copper/40
    lead/30
    titanium/80
    silicon/30
  ]

  ammoTypes: {

    metaglass:	{
		type: ArtilleryBulletType
		speed: 10
		splashDamage: 35
		splashDamageRadius: 30
		lifetime: 20
		width: 20
		height: 20
		collidesTiles: true
	  reloadMultiplier: 2
    shootEffect: "shootBig2"
		fragBullet: {
      shootEffect: "flakExplosion"
			type: BasicBulletType
			speed: 10
			damage: 30
			width: 10
			height: 12
			shrinkY: 1
			lifetime: 10
			despawnEffect: none
			collidesAir: true
		}
		fragBullets: 10
	}

    silicon: {
    type: missileBulletType
      speed: 5
		  splashDamage: 80
		  splashDamageRadius: 10
      bulletWidth: 120
      bulletHeight: 120
      lifetime: 150
      shootEffect: "shootBig2"
      homingPower: .3
      homingRange: 100
      fragBullet: {
        shootEffect: "plasticExplosionFlak"
			  type: BasicBulletType
			  speed: 3
			  damage: 30
			  width: 10
			  height: 12
			  shrinkY: 1
			  lifetime: 5
			  despawnEffect: none
			  collidesAir: true
      }
		fragBullets: 4
    }

plastanium: {
		type: ArtilleryBulletType
      speed: 20
		  splashDamage: 100
		  splashDamageRadius: 40
      bulletWidth: 320
      bulletHeight: 320
		knockback: 1
      lifetime: 40
      shootEffect: "shootBig2"
      fragBullet: {
        shootEffect: "flakExplosion"
			  type: BasicBulletType
			  speed: 10
			  damage:50
			  width: 10
			  height: 12
			  shrinkY: 1
			  lifetime: 30
			  despawnEffect: none
			  collidesAir: true
      }
		fragBullets: 20
    }

  }
  shoot: {
  type: ShootAlternate
  shots: 3
  spread: 3.5
  shotDelay: 7.5
}

  category: "turret"
  research: "Scatter"
}