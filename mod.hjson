{
  // The name displayed in the in-game mod list
  displayName: "Bigger Turrets"

  // Internal unique identifier (use dashes, no spaces)
  name: "Bigger-Turrets"

  // Your name or handle
  author: "AlexandreMonoyioudis"

  // A short description of what your mod adds to the game
  description: """Turret spam is boring. These turrets are bigger stronger but require more complex supply chains. 
  
  + heavy cannon that requires constant coolant.
  + swarm launcher that uses silicon and electrisity.
  + 2x2 solar panel
  """

  // The current version of your mod
  version: "1.0"

  // The minimum Mindustry game version required to run this mod
  minGameVersion: "146"
}